PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://anime:anime_dev_password@localhost:5433/anime_companion
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
VOICE_SERVICE_URL=http://127.0.0.1:8000

# Generated by npm run setup; do not copy into VITE variables
LOCAL_API_TOKEN=

# Select LocalAI instead of Ollama/FastAPI
AI_PROVIDER=ollama
VOICE_PROVIDER=fastapi
LOCALAI_URL=http://127.0.0.1:8080
# Optional LocalAI server API key (not the same as LOCAL_API_TOKEN)
LOCALAI_API_KEY=
# These IDs must be installed through the LocalAI model gallery
LOCALAI_CHAT_MODEL=qwen3-4b
LOCALAI_VISION_MODEL=moondream2-20250414
LOCALAI_STT_MODEL=whisper-1
LOCALAI_TTS_MODEL=tts-1
LOCALAI_TTS_VOICE=alloy

# MOSS Voice Studio TTS (keep the API key on this backend only)
VOICE_TTS_PROVIDER=moss
VOICE_STUDIO_URL=http://127.0.0.1:8001
VOICE_STUDIO_API_KEY=
# Legacy fallback voice ID (avoid using one voice for two different languages)
VOICE_STUDIO_VOICE_ID=
# Preferred English reference voice (must be a registered English /v1/voices ID)
VOICE_STUDIO_EN_VOICE_ID=
VOICE_STUDIO_EN_ENGINE=chatterbox-turbo
# Optional Thai reference voice; MOSS original can use a built-in voice without one
VOICE_STUDIO_TH_VOICE_ID=
VOICE_STUDIO_TH_ENGINE=moss


# Profile and memories can stay in Thai for Qwen, avoiding repeat translations.
CHAT_TRANSLATE_PROFILE=false
# Faster first reply: skip extra post-response Ollama emotion inference.
CHAT_EMOTION_MODE=fast
# Maximum reply tokens (both English and Thai); lower is faster but may truncate.
OLLAMA_NUM_PREDICT=350
# 8GB GPUs: keep false unless there is enough free VRAM for Ollama + MOSS.
# true permits TTS while Ollama is still generating text when Auto Speak is on.
VOICE_STREAM_CONCURRENT_GPU=false


# True MOSS PCM audio streaming is automatically enabled when the MOSS Studio
# /v1/stream/status endpoint reports configured=true and ready=true.
# Configure SGLANG_BASE_URL in the separate MOSS Voice Studio backend/.env.
# SGLang-Omni returns pcm_s16le/48000Hz/mono; Chatterbox-Turbo still uses WAV jobs.
# Streaming shares the GPU lock with Ollama unless VOICE_STREAM_CONCURRENT_GPU=true.

# Chatterbox sentence PCM streaming works without SGLang after warming Turbo:
# POST MOSS /v1/chatterbox/load; then /v1/stream/status.
# VOICE_STUDIO_EN_ENGINE=chatterbox-turbo retains your English reference voice.

# Optional MCP tool connections (Streamable HTTP protocol 2025-03-26 to 2025-11-25).
# Configure server endpoints ONLY here in the backend, never in VITE_ variables.
# Explicit allowlist: an empty allowedTools array exposes no tools.
# Example requires a separately running MCP server on this address.
MCP_SERVERS_JSON=[]
# MCP_SERVERS_JSON=[{"id":"example","url":"http://127.0.0.1:3009/mcp","allowedTools":["read_status"],"tokenEnv":"EXAMPLE_MCP_TOKEN"}]
# EXAMPLE_MCP_TOKEN=put-server-secret-here
# Leave false unless you explicitly trust HTTP endpoints outside loopback.
MCP_ALLOW_INSECURE_HTTP=false
