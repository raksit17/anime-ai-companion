{
  "name": "@companion/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "npm run build && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "class-validator": "^0.14.2",
    "class-transformer": "^0.5.1",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0"
  }
}
