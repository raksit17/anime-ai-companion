{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Komorebi",
  "version": "0.3.0",
  "identifier": "local.komorebi.companion",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5174",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "chat",
        "title": "Komorebi \u00b7 Chat",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "visible": true
      },
      {
        "label": "companion",
        "title": "Komorebi \u00b7 Companion",
        "url": "index.html?view=companion",
        "width": 360,
        "height": 580,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:3001 http://localhost:3001 ws://127.0.0.1:3001 ws://localhost:3001; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}