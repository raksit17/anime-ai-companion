{
  "name": "anime-ai-companion",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "generate": "npm run generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "desktop:dev": "npm run tauri:dev -w apps/web",
    "desktop:build": "npm run tauri:build -w apps/web",
    "live2d:setup": "node scripts/setup-live2d-r5.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10"
  }
}
